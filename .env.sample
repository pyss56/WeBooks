# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO

# 日志保留天数（默认60天，按小时轮转）
LOG_RETENTION_DAYS=60

# Flask
SECRET_KEY=your-secret-key-here

# 企业微信自建应用配置
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_CORP_SECRET=your-corp-secret
WECOM_TOKEN=your-wecom-token
WECOM_ENCODING_AES_KEY=your-encoding-aes-key
WECOM_AGENT_URL=your-agent-url

# 企业微信 API 地址（一般无需修改）
# WECOM_API_BASE_URL=https://qyapi.weixin.qq.com

# 时区
TIMEZONE=Asia/Shanghai

# 推送用户，默认推送给全部
WECOM_TO_USER=@all

# 管理员用户名和密码（预算管理页面需要）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-admin-password

# 服务外部访问地址（用于生成菜单链接、汇总图表链接等）
BASE_URL=http://your-domain:5001

# PC端访问入口编码（企业微信自建应用主页URL拼接用，没有子路径访问不了）
# 例如企业微信主页URL设置为 http://your-domain:5001/xxx/，则填 xxx
WEB_ENTRY_CODE=
# 未带入口编码时的跳转地址
WEB_ENTRY_REDIRECT=https://example.com

# 企业微信 OAuth 登录开关（汇总图表免验证码，需 HTTPS + 可信域名）
WECOM_OAUTH_ENABLED=false
